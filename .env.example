RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MySQL (mesmo banco consultado pelos serviços idc_*) usado para montar o
# payload real a partir de um unidadeId em vez de dados aleatórios.
IDC_MYSQL_HOST_PROD=
IDC_MYSQL_PORT_PROD=3306
IDC_MYSQL_USER_PROD=
IDC_MYSQL_PASS_PROD=
IDC_MYSQL_DB_PROD=

# API de extracao de faturas (idc_api_extract) usada pelos botoes
# "Extrair Prod" / "Extrair Local" na visualizacao de PDF da unidade.
EXTRACT_API_URL_LOCAL=http://localhost:4001
EXTRACT_API_URL_PROD=http://idc.solarview.com.br:4001

# MySQL do banco integracao_digital_log, usado pela pagina de Portais para
# consultar o historico de requisicoes dos robos de integracao (logRequisicoesRobos).
DB_INTEGRACAO_DIGITAL_LOG_HOST=
DB_INTEGRACAO_DIGITAL_LOG_PORT=3306
DB_INTEGRACAO_DIGITAL_LOG_USERNAME=
DB_INTEGRACAO_DIGITAL_LOG_PASSWORD=
DB_INTEGRACAO_DIGITAL_LOG_DATABASE=
